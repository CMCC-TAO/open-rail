    independent:0
    middleware:"ligo"
    recv_target_socs:3
    enable:0
}
topic_config{
    bus_topic_name: "front_right_camera"
    independent:0
    middleware:"ligo"
    recv_target_socs:3
    enable:0
}
topic_config{
    bus_topic_name: "cosine/lord/safety/slave_arg_alarm_state"
    middleware:"aorta"
    qos: {reliability : 1 durability : 2 history : 1 depth : 5}
}

