# send
topic_config{
    bus_topic_name: "rear_short_camera"
    independent:0
    middleware:"ligo"
    send_target_socs:2
    enable:0
}
topic_config{
    bus_topic_name: "front_wide_camera"
    independent:0
    middleware:"ligo"
    send_target_socs:2
    enable:0
}
topic_config{
    bus_topic_name: "front_short_camera"
    independent:0
    middleware:"ligo"
    send_target_socs:4
    enable:0
}
topic_config{
    bus_topic_name: "park_left_camera"
    independent:0
    middleware:"ligo"
    send_target_socs:2
    enable:0
}
topic_config{
    bus_topic_name: "park_right_camera"
    independent:0
    middleware:"ligo"
    send_target_socs:2
    enable:0
}
topic_config{
    bus_topic_name: "cosine/lord/safety/master_arg_alarm_state"
    middleware:"aorta"
    qos: {reliability : 1 durability : 2 history : 1 depth : 5}
}

# recv
# s3
