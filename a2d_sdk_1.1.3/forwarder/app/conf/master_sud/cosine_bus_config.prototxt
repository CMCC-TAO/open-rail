}

topic_config{
    bus_topic_name:"common/map_engine/global_hd_routes"
    middleware:"someip"
    net_id:0
    msg_type:"GlobalHDRouteGuide"
}

topic_config{
    bus_topic_name: "common/dlb/record_response"
    independent:0
    middleware:"aorta"
}

# someip env
env{
    key:"VSOMEIP_CONFIGURATION"
    value:"/home/mazu/app/conf/s1_someip/cosine-someip.json"
}
env{
    key:"COMMONAPI_CONFIG"
    value:"/home/mazu/app/conf/s1_someip/cosine-commonapi.ini"
}
env{
    key:"COMMONAPI_SOMEIP_CONFIG"
    value:"/home/mazu/app/conf/s1_someip/cosine-commonapi-someip.ini"
}

# station-to-station send
