# someip recv
topic_config{
    bus_topic_name: "common/map_engine/sd_map_package"
    middleware:"someip"
    net_id:0
    msg_type:"SDMapInfo"
}

topic_config{
    bus_topic_name:"common/map_engine/route_match_request_package"
    middleware:"someip"
    net_id:0
    msg_type:"RequestPackage"
}

topic_config{
    bus_topic_name:"common/avp/location_info"
    middleware:"someip"
    net_id:1
    msg_type:"LocationInfo"
}

topic_config{
    bus_topic_name:"common/avp/map_task_request"
    middleware:"someip"
    net_id:1
    msg_type:"MapTaskMethod"
}

# someip send
topic_config{
    bus_topic_name:"common/avp/arg_app_map_task_response"
    middleware:"someip"
    net_id:1
    msg_type:"MapTaskEvent"
}

topic_config{
    bus_topic_name:"common/map_engine/hd_routes_guide_info"
    middleware:"someip"
    net_id:0
    msg_type:"HDRouteGuide"
}

topic_config{
    bus_topic_name:"common/map_engine/sd_map_inquiry_result"
    middleware:"someip"
    net_id:0
