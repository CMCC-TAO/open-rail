# someip recv
topic_config{
    bus_topic_name: "common/oms/oms_request"
    middleware:"someip"
    net_id:2
    msg_type:"OmsCapability"
}

# someip send
topic_config{
    bus_topic_name:"common/oms/oms_response"
    middleware:"someip"
    net_id:2
    msg_type:"OmsCapabilityResult"
}

# someip env
env{
    key:"VSOMEIP_CONFIGURATION"
    value:"/home/mazu/app/conf/s2_someip/cosine-someip.json"
}
env{
    key:"COMMONAPI_CONFIG"
    value:"/home/mazu/app/conf/s2_someip/cosine-commonapi.ini"
}
env{
    key:"COMMONAPI_SOMEIP_CONFIG"
    value:"/home/mazu/app/conf/s2_someip/cosine-commonapi-someip.ini"
}
