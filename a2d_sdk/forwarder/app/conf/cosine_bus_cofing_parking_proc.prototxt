

# someip recv
topic_config{
    bus_topic_name: "common/vehicle_in/pwrswapstn_info"
    middleware:"someip"
    net_id:4
    msg_type:"PSAPStationInfoReq"
    transponds:{
        middleware:"aorta"
    }
}

# someip env
env{
    key:"VSOMEIP_CONFIGURATION"
    value:"/home/mazu/app/conf/s3_someip/cosine-someip.json"
}
env{
    key:"COMMONAPI_CONFIG"
    value:"/home/mazu/app/conf/s3_someip/cosine-commonapi.ini"
}
env{
    key:"COMMONAPI_SOMEIP_CONFIG"
    value:"/home/mazu/app/conf/s3_someip/cosine-commonapi-someip.ini"
}

