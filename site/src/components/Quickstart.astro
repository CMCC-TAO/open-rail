---
import { getUI } from '../i18n';
const { locale = 'en' } = Astro.props;
const t = getUI(locale);
const icons: Record<string, string> = {
  flask: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  robot: '<rect x="4" y="8" width="16" height="11" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 4v4M9 13h.01M15 13h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  wrench: '<path d="M14 7a4 4 0 0 0-5 5l-6 6 3 3 6-6a4 4 0 0 0 5-5l-2 2-2-2 2-2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
};
const iconKeys = ['flask', 'robot', 'wrench'];
---

<section id="quickstart" class="section bg-white/5">
  <div class="container-wide">
    <div class="text-center">
      <p class="eyebrow">GET STARTED</p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{t.quick.title}</h2>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {t.quick.steps.map((q, i) => (
        <div class="card lift reveal">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand to-accent text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24"><Fragment set:html={icons[iconKeys[i]]} /></svg>
            </span>
            <span class="text-2xl font-extrabold gradient-text">{i + 1}</span>
          </div>
          <h3 class="mt-4 text-lg font-bold text-white">{q.title}</h3>
          <p class="mt-2 text-sm text-slate-400">{q.body}</p>
        </div>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-slate-400">{t.quick.resourcesLabel}</p>
    <div class="mt-5 flex justify-center">
      <a class="btn-primary" href="#overview">{t.quick.start}</a>
    </div>
  </div>
</section>
