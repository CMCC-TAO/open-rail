---
import { site } from '../data/site';
import { getUI } from '../i18n';
const BASE = import.meta.env.BASE_URL;
const { locale = 'en' } = Astro.props;
const t = getUI(locale);
const links = [
  { href: `${BASE}#overview`, label: t.nav.overview },
  { href: `${BASE}#architecture`, label: t.nav.architecture },
  { href: `${BASE}#capabilities`, label: t.nav.capabilities },
  { href: `${BASE}#models`, label: t.nav.models },
  { href: `${BASE}#robots`, label: t.nav.robots },
  { href: `${BASE}#get-involved`, label: t.nav.getInvolved },
  { href: `${BASE}#quickstart`, label: t.nav.quickstart },
  { href: `${BASE}#tutorials`, label: t.nav.showcase },
  { href: `${BASE}getting-started/`, label: t.nav.docs },
];

---

<header class="sticky top-0 z-50 border-b border-ink-border bg-white/80 backdrop-blur dark:bg-ink/80">
  <nav class="container-wide flex h-16 items-center justify-between gap-4">
    <a href={BASE} class="flex items-center leading-tight">
      <span class="text-2xl font-extrabold tracking-tight gradient-text">Open-RAIL</span>
    </a>

    <div class="hidden items-center gap-6 text-sm font-medium xl:flex">
      {links.map((l) => <a class="hover:text-brand" href={l.href}>{l.label}</a>)}
    </div>

    <div class="flex items-center gap-2">
      <button id="theme-toggle" class="btn-ghost px-2" aria-label={t.nav.themeLabel}>
        <svg class="h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
        </svg>
        <svg class="hidden h-5 w-5 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32l1.41-1.41" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
