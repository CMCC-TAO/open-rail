---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<span class="brand-title" translate="no">Open-RAIL</span>
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: var(--sl-nav-gap);
		text-decoration: none;
		white-space: nowrap;
	}
	.brand-title {
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.01em;
		background: linear-gradient(90deg, #2478ff, #9254ff);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>
