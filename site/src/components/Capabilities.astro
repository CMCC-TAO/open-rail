---
import { getUI } from '../i18n';
import EdgeCloudDiagram from './EdgeCloudDiagram.astro';
import Highlight from './Highlight.astro';
import FlywheelDiagram from './FlywheelDiagram.astro';
const { locale = 'en' } = Astro.props;
const t = getUI(locale);
const d = getUI(locale).diagrams.threads;
const kindByIndex = ['threads', 'edge', 'flywheel'] as const;
---

<section id="capabilities" class="section">
  <div class="container-wide">
    <div class="text-center">
      <p class="eyebrow">CORE CAPABILITIES</p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{t.cap.title}</h2>
    </div>

    <div class="mt-12 space-y-8">
      {t.cap.items.map((c, i) => (
        <div class="card reveal grid gap-8 lg:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-brand"><Highlight text={c.tag} /></p>
            <h3 class="mt-1 text-2xl font-bold text-white"><Highlight text={c.title} /></h3>
            <p class="text-sm font-medium text-brand-light"><Highlight text={c.subtitle} /></p>
            <p class="mt-3 text-sm leading-relaxed text-slate-400"><Highlight text={c.summary} /></p>

            <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
              {c.metrics.map((m) => (
                <div class="rounded-xl border border-ink-border bg-white/5 p-3 text-center">
                  <div class="stat !text-xl"><Highlight text={m.value} /></div>
                  <div class="mt-1 text-[11px] text-slate-400"><Highlight text={m.label} /></div>
                </div>
              ))}
            </div>

            <details class="group mt-5 rounded-xl border border-ink-border bg-white/5 p-3">
              <summary class="cursor-pointer list-none text-sm font-semibold text-slate-200">
                <span class="group-open:hidden">▸ {t.cap.expand}</span>
                <span class="hidden group-open:inline">▾ {t.cap.collapse}</span>
              </summary>
              <ul class="mt-3 space-y-2 text-sm text-slate-400">
                {c.details.map((dt) => (
                  <li class="flex gap-2"><span class="text-brand">•</span><span><Highlight text={dt} /></span></li>
                ))}
              </ul>
            </details>
          </div>

          <div class="flex items-center justify-center rounded-2xl border border-ink-border bg-white/5 p-4">
            {kindByIndex[i] === 'edge' && (
              <div class="w-full cursor-zoom-in" data-zoom><EdgeCloudDiagram locale={locale} /></div>
            )}
            {kindByIndex[i] === 'flywheel' && (
              <div class="w-full max-w-sm cursor-zoom-in" data-zoom><FlywheelDiagram locale={locale} /></div>
            )}
            {kindByIndex[i] === 'threads' && (
              <svg viewBox="0 0 420 260" class="w-full cursor-zoom-in" data-zoom role="img" aria-label={d.title}>
                <text x="10" y="20" fill="#94a3b8" font-size="12">{d.title}</text>
                {[
                  { y: 60, c: '#2478FF', t: d.obs },
                  { y: 120, c: '#7c5cff', t: d.infer },
                  { y: 180, c: '#9254FF', t: d.control },
                ].map((l) => (
                  <g>
                    <rect x="10" y={l.y - 14} width="400" height="22" rx="6" fill="#1b1e27" stroke={l.c} />
                    <text x="20" y={l.y + 2} fill="#e2e8f0" font-size="12">{l.t}</text>
                  </g>
                ))}
                <line x1="120" y1="74" x2="120" y2="180" stroke="#3a3f4d" stroke-width="1.5" stroke-dasharray="4 4" />
                <text x="128" y="130" fill="#4d94ff" font-size="11">{d.buffer}</text>
              </svg>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
