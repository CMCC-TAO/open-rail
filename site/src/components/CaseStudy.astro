---
import { getUI } from '../i18n';
const { locale = 'en' } = Astro.props;
const t = getUI(locale);
---

<section id="case" class="section bg-white/5">
  <div class="container-wide">
    <div class="text-center">
      <p class="eyebrow">BENCHMARK CASE</p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{t.case.title}</h2>
    </div>

    <div class="mt-12 grid items-center gap-10 lg:grid-cols-2">
      <div class="card overflow-hidden p-0 reveal">
        <div class="flex aspect-video items-center justify-center border border-ink-border bg-gradient-to-br from-ink-card to-ink text-center">
          <div class="px-6">
            <p class="text-sm font-medium text-slate-300">{t.case.placeholderTitle}</p>
            <p class="mt-1 text-xs text-slate-500">{t.case.placeholderNote}</p>
          </div>
        </div>
      </div>

      <div class="reveal">
        <p class="text-sm leading-relaxed text-slate-300">{t.case.background}</p>
        <div class="mt-4 rounded-xl border border-ink-border bg-white/5 p-4">
          <p class="text-xs uppercase tracking-wider text-slate-500">{t.case.stackLabel}</p>
          <p class="mt-1 text-sm text-slate-200">{t.case.stack}</p>
        </div>

        <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {t.case.metrics.map((m) => (
            <div class="rounded-xl border border-ink-border bg-white/5 p-3 text-center">
              <div class="stat !text-2xl">{m.value}</div>
              <div class="mt-1 text-[11px] text-slate-400">{m.label}</div>
            </div>
          ))}
        </div>

        <p class="mt-5 text-sm text-slate-400">
          <span class="text-slate-200">{t.case.scenesLabel}</span>{t.case.scenes}
        </p>
      </div>
    </div>
  </div>
</section>
