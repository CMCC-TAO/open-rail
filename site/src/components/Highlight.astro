---
// Renders text with inline highlight markers:
//   **text** → bold, *text* → italic, ==text== → red highlight,
//   %%text%% → numeric pill (brand-tinted; used for key counts, e.g. "20 models").
interface Props {
  text?: string;
}
const { text = '' } = Astro.props;
const re = /(\*\*[^*]+\*\*|\*[^*\n]+\*|==[^=]+==|%%[^%]+%%)/g;
const parts = text
  .split(re)
  .filter((p) => p !== '')
  .map((p: string) => {
    let m = p.match(/^\*\*([^*]+)\*\*$/);
    if (m) return { text: m[1], style: 'bold' as const };
    m = p.match(/^\*([^*]+)\*$/);
    if (m) return { text: m[1], style: 'italic' as const };
    m = p.match(/^==([^=]+)==$/);
    if (m) return { text: m[1], style: 'red' as const };
    m = p.match(/^%%([^%]+)%%$/);
    if (m) return { text: m[1], style: 'pill' as const };
    return { text: p, style: 'normal' as const };
  });
---
<Fragment>
  {parts.map((s) =>
    s.style === 'bold' ? (
      <strong class="font-semibold">{s.text}</strong>
    ) : s.style === 'italic' ? (
      <em class="italic">{s.text}</em>
    ) : s.style === 'red' ? (
      <span class="text-red-400">{s.text}</span>
    ) : s.style === 'pill' ? (
      <span class="whitespace-nowrap rounded-md bg-brand/15 px-1.5 font-semibold text-brand-light">{s.text}</span>
    ) : (
      s.text
    )
  )}
</Fragment>
