---
import { showcase } from '../data/site';
const BASE = import.meta.env.BASE_URL;
const src = `${BASE}media/showcase.mp4`;
---

<section id="showcase" class="section bg-white/5">
  <div class="container-wide">
    <div class="text-center">
      <p class="eyebrow">SHOWCASE VIDEO</p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">See Open-RAIL run on real robots</h2>
    </div>

    <div class="mt-10">
      <!--
        Drop your demo clip at: site/public/media/showcase.mp4
        Then uncomment the <video> below and remove the placeholder.
      -->
      <div class="card overflow-hidden p-0 reveal">
        <div class="relative flex aspect-video items-center justify-center bg-gradient-to-br from-ink-card to-ink">
          <div class="flex flex-col items-center text-center">
            <span class="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-brand to-accent text-white shadow-lg">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <p class="mt-4 text-sm font-medium text-slate-300">{showcase.caption}</p>
            <p class="mt-1 text-xs text-slate-500">{showcase.note}</p>
          </div>
        </div>
      </div>

      {/*
      <div class="card overflow-hidden p-0 reveal">
        <video class="aspect-video w-full" controls preload="metadata" poster={`${BASE}media/showcase-poster.png`}>
          <source src={src} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
      */}
    </div>
  </div>
</section>
