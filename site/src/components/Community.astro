---
import { getUI } from '../i18n';
import { site } from '../data/site';
import { platformIcons } from '../data/icons';
import Highlight from './Highlight.astro';
const { locale = 'en' } = Astro.props;
const t = getUI(locale);
const c = t.community;

const BASE = import.meta.env.BASE_URL;
const REPO = 'https://github.com/CMCC-TAO/open-rail';

// Copy keeps destinations as tokens, so the wording stays reviewable in i18n.ts.
const LINK: Record<string, string> = {
  '{DISCUSSIONS}': `${REPO}/discussions`,
  '{ISSUES}': `${REPO}/issues`,
  '{PR_LIST}': `${REPO}/pulls`,
  '{CONTRIBUTING}': `${REPO}/blob/main/CONTRIBUTING.md`,
  '{DOC_ADD_MODEL}': `${BASE}guides/add-new-model/`,
  '{DOC_ADD_ROBOT}': `${BASE}guides/add-new-robot/`,
  '{DOC_ADD_SMOOTHER}': `${BASE}guides/add-new-inter-chunk-fuser/`,
  '{DOCS}': `${BASE}getting-started/`,
  '{ARCH}': `${BASE}architecture/`,
};
const resolve = (token: string) => LINK[token];
---

<section id="get-involved" class="section scroll-mt-24">
  <div class="container-wide">
    <!-- Section head. The title is the promise; the note panel directly under it carries the invitation. -->
    <div class="text-center">
      <p class="eyebrow"><Highlight text={c.eyebrow} /></p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        <Highlight text={c.title} /> <span class="gradient-text"><Highlight text={c.titleGrad} /></span>
      </h2>
      <p class="mx-auto mt-6 max-w-[54rem] rounded-2xl border border-brand/25 bg-brand/5 px-5 py-4 text-left text-sm leading-relaxed text-slate-300">
        <Highlight text={c.note} />
      </p>
    </div>

    <!-- Who it's for: identity + what you get. Never says how to do it. -->
    <h3 class="mt-12 text-center text-xl font-bold text-white">{c.whoTitle}</h3>
    <p class="mt-1.5 text-center text-sm text-slate-500">{c.whoSub}</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {c.who.map((w) => (
        <div class="card reveal p-5">
          <h4 class="text-base font-bold text-white">{w.name}</h4>
          <p class="mt-2 text-sm leading-relaxed text-slate-400"><Highlight text={w.body} /></p>
        </div>
      ))}
    </div>

    <!-- Ways to contribute: what already exists + what you can add. Never repeats the value pitch. -->
    <h3 class="mt-12 text-center text-xl font-bold text-white">{c.waysTitle}</h3>
    <div class="mt-5 grid gap-4 lg:grid-cols-3">
      {c.ways.map((w) => (
        <div class="card reveal flex flex-col p-5">
          <p class="self-start rounded-md bg-brand/10 px-2 py-0.5 text-[11px] font-bold uppercase tracking-[0.13em] text-brand-light">
            <Highlight text={w.tier} />
          </p>
          <h4 class="mt-3 text-base font-bold text-white"><Highlight text={w.title} /></h4>
          <p class="mb-4 mt-2 text-sm leading-relaxed text-slate-400"><Highlight text={w.body} /></p>
          <div class="mt-auto flex flex-col items-start gap-2 border-t border-ink-border pt-3">
            {w.ctas.map((a) => (
              <a class="inline-flex items-center gap-1 text-sm font-semibold text-brand-light hover:text-brand" href={resolve(a.href)}>
                {a.label}
                <span aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Single closing entry: code first, process second. -->
    <div class="card mt-8 p-6 text-center">
      <h4 class="text-base font-bold text-white">{c.entryTitle}</h4>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
        {site.platforms.map((p, i) => (
          <a class={i === 0 ? 'btn-primary px-4 py-2' : 'btn-ghost px-4 py-2'} href={p.href} title={p.label} aria-label={p.label}>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><Fragment set:html={platformIcons[p.icon]} /></svg>
            <span>{p.label}</span>
          </a>
        ))}
      </div>
      <p class="mt-4 text-sm text-slate-400">
        {c.entryNote}{' '}
        <a class="font-semibold text-brand-light hover:text-brand" href={resolve('{CONTRIBUTING}')}>{c.entryContrib}</a>
        <span aria-hidden="true" class="mx-1.5 text-slate-500">&middot;</span>
        <a class="font-semibold text-brand-light hover:text-brand" href={resolve('{PR_LIST}')}>{c.entryPr}</a>
      </p>
    </div>
  </div>
</section>
