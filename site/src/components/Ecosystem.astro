---
import { getUI } from '../i18n';
import { site } from '../data/site';
const { locale = 'en' } = Astro.props;
const t = getUI(locale);
---

<section id="ecosystem" class="section">
  <div class="container-wide">
    <div class="text-center">
      <p class="eyebrow">OPEN ECOSYSTEM</p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{t.eco.title}</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-300">{t.eco.vision}</p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {t.eco.templates.map((tm) => (
        <div class="card lift reveal">
          <h3 class="text-base font-bold text-white">{tm.title}</h3>
          <p class="mt-2 text-sm text-slate-400">{tm.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-2xl border border-ink-border bg-gradient-to-r from-brand/10 to-accent/10 p-6">
      <p class="text-sm font-semibold text-slate-200">{t.eco.entryLabel}</p>
      <div class="mt-3 flex flex-wrap gap-3">
        {site.platforms.map((p) => (
          <a class="btn-ghost" href={p.href}>{p.label}</a>
        ))}
        <a class="btn-ghost" href={site.whitepaper}>{t.eco.paperLabel}</a>
      </div>
      <p class="mt-3 text-xs text-slate-500">{t.eco.resourcesLabel}</p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {t.eco.values.map((v) => (
        <div class="rounded-xl border border-ink-border bg-white/5 p-4">
          <p class="text-sm font-semibold text-brand-light">{v.who}</p>
          <p class="mt-1 text-sm text-slate-400">{v.value}</p>
        </div>
      ))}
    </div>
  </div>
</section>
