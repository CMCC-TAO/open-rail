---
import { getUI } from '../i18n';
const { locale = 'en' } = Astro.props;
const t = getUI(locale);
const BASE = import.meta.env.BASE_URL;
---

<section id="architecture" class="section bg-white/5">
  <div class="container-wide">
    <div class="text-center">
      <p class="eyebrow">{t.pos.eyebrow}</p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{t.pos.title}</h2>
    </div>

    <!-- Architecture diagram, placed directly under the title -->
    <div class="mt-10">
      <p class="mb-3 text-center text-xs text-slate-500">{t.pos.diagramCaption}</p>
      <div class="card p-4 reveal cursor-zoom-in" data-zoom>
        <img
          src={`${BASE}media/architecture.png`}
          alt="Open-RAIL RAIL Architecture"
          class="h-auto w-full rounded-lg"
        />
      </div>
    </div>

    <!-- Roles -->
    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      {t.pos.roles.map((r) => (
        <div class="card lift reveal text-center">
          <h3 class="text-lg font-bold text-white">{r.name}</h3>
          <p class="mt-2 text-sm text-slate-400">{r.desc}</p>
        </div>
      ))}
    </div>

    <!-- Body, placed under the roles -->
    <p class="mx-auto mt-8 max-w-3xl text-center text-slate-300">{t.pos.body}</p>
  </div>
</section>
