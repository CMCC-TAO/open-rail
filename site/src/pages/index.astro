---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Positioning from '../components/Positioning.astro';
import Capabilities from '../components/Capabilities.astro';
import ModelsRobots from '../components/ModelsRobots.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
import Community from '../components/Community.astro';
import QuickStart from '../components/QuickStart.astro';
import Footer from '../components/Footer.astro';
const locale = 'en';
---

<BaseLayout>
  <Hero locale={locale} />
  <Positioning locale={locale} />
  <Capabilities locale={locale} />
  <ModelsRobots />
  <VideoShowcase />
  <Community locale={locale} />
  <QuickStart locale={locale} />
  <Footer locale={locale} />
</BaseLayout>
